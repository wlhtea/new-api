    {
      "name": "02 - 查询与下载",
      "description": "使用创建请求自动保存的 task_id。生成时间较长时可以重复执行状态查询；只有 completed 后再下载内容。",
      "item": [
        {
          "name": "查询任务状态",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "const expectedTaskId = pm.variables.get(\"task_id\");",
                  "const allowedStatuses = [\"queued\", \"in_progress\", \"completed\", \"failed\"];",
                  "pm.test(\"任务状态合同\", function () {",
                  "  pm.expect(body.id).to.eql(expectedTaskId);",
                  "  pm.expect(body.task_id).to.eql(expectedTaskId);",
                  "  pm.expect(body.object).to.eql(\"video\");",
                  "  pm.expect(body.model).to.eql(\"seedance-uncensored\");",
                  "  pm.expect(allowedStatuses).to.include(body.status);",
                  "  pm.expect(Number.isInteger(body.progress)).to.eql(true);",
                  "  pm.expect(body.progress).to.be.within(0, 100);",
                  "  pm.expect(Number.isInteger(body.created_at)).to.eql(true);",
                  "  pm.expect(body.created_at).to.be.above(0);",
                  "  pm.expect(body.seconds).to.match(/^[0-9]+$/);",
                  "  pm.expect([\"480P\", \"720P\", \"1080P\"]).to.include(body.size);",
                  "  pm.expect(body.seconds).to.eql(pm.variables.get(\"expected_seconds\"));",
                  "  pm.expect(body.size).to.eql(pm.variables.get(\"expected_size\"));",
                  "  if ([\"completed\", \"failed\"].includes(body.status)) {",
                  "    pm.expect(Number.isInteger(body.completed_at)).to.eql(true);",
                  "    pm.expect(body.completed_at).to.be.above(0);",
                  "  } else {",
                  "    pm.expect(body).not.to.have.property(\"completed_at\");",
                  "  }",
                  "  if (body.status === \"completed\") {",
                  "    pm.expect(body.progress).to.eql(100);",
                  "  }",
                  "  if (body.status === \"failed\") {",
                  "    pm.expect(body.error.message).to.be.a(\"string\");",
                  "    pm.expect(body.error.code).to.be.a(\"string\");",
                  "  }",
                  "});",
                  "if (pm.response.code === 200 && allowedStatuses.includes(body.status)) {",
                  "  pm.collectionVariables.set(\"task_status\", body.status);",
                  "  pm.environment.set(\"task_status\", body.status);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/videos/{{task_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "videos",
                "{{task_id}}"
              ]
            },
            "description": "重复执行直到 status 为 completed 或 failed。服务端通过供应商状态轮询和 durable task 快照返回当前状态。"
          },
          "response": []
        },
        {
          "name": "下载完成视频",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const taskId = pm.variables.get(\"task_id\");",
                  "const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
                  "const contentLength = Number(pm.response.headers.get(\"Content-Length\"));",
                  "const disposition = pm.response.headers.get(\"Content-Disposition\") || \"\";",
                  "const cacheControl = pm.response.headers.get(\"Cache-Control\") || \"\";",
                  "const nosniff = pm.response.headers.get(\"X-Content-Type-Options\") || \"\";",
                  "pm.test(\"返回完整 MP4 下载合同\", function () {",
                  "  pm.expect(contentType.toLowerCase()).to.include(\"video/mp4\");",
                  "  pm.expect(contentLength).to.be.above(0);",
                  "  pm.expect(disposition).to.include(taskId);",
                  "  pm.expect(disposition).to.include(\".mp4\");",
                  "  pm.expect(cacheControl.toLowerCase()).to.include(\"private\");",
                  "  pm.expect(nosniff.toLowerCase()).to.eql(\"nosniff\");",
                  "  if (typeof pm.response.responseSize === \"number\") {",
                  "    pm.expect(pm.response.responseSize).to.be.above(0);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "video/mp4",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/videos/{{task_id}}/content",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "videos",
                "{{task_id}}",
                "content"
              ]
            },
            "description": "仅在任务 completed 后执行。响应为二进制 video/mp4，可在 Apifox 中保存响应到文件。"
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - 无费用参数拒绝用例",
      "description": "这些请求应在 New API 本地参数验证阶段返回 400/404，不应创建供应商任务。若任何 POST 返回 2xx，立即停止，不要继续批量执行。",
      "item": [
        {
          "name": "拒绝 duration=0",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"错误码 invalid_duration\", function () {",
                  "  pm.expect(body).to.have.nested.property(\"error.code\", \"invalid_duration\");",
                  "  pm.expect(body).to.have.nested.property(\"error.type\", \"invalid_request_error\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
